# ═════════════════════════════════════════════════════════════
# Couchbeam — environment template
#
#   cp .env.example .env
#
# SECURITY
#   • NEVER commit .env or any real secret. .gitignore blocks it, but
#     the habit matters more than the ignore rule.
#   • Every value below is a DUMMY. Generate real secrets yourself:
#         openssl rand -base64 48
#   • Rotate a secret immediately if it ever appears in a commit, log,
#     screenshot or chat. Deleting the commit is NOT enough — rotate.
#   • CI runs gitleaks on every push (see .github/workflows/ci.yml).
#
# Legend:  [USED]     read by v1 of the code today
#          [RESERVED] documented for the scale-out roadmap; v1 ignores it
# ═════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
# [USED] development | production | test
NODE_ENV=development

# [USED] TCP port the HTTP + WebSocket server listens on
PORT=8080

# [USED] Bind address. 0.0.0.0 inside Docker, 127.0.0.1 for local-only dev
HOST=0.0.0.0

# [USED] debug | info | warn | error | silent
LOG_LEVEL=info

# ── Security ─────────────────────────────────────────────────
# [USED] HMAC key that signs reconnect ("resume") tokens so a client cannot
# impersonate another member after a network drop.
# Format: random string, >= 32 characters. REQUIRED when NODE_ENV=production
# (the server refuses to boot with a short or default value).
# If unset in development, a random key is generated per boot (resume tokens
# then stop working across server restarts, which is fine for dev).
SESSION_SECRET=change-me-dummy-value-0000000000000000

# [USED] Comma-separated list of browser Origins allowed to open a WebSocket.
# Format: scheme://host[:port], no trailing slash. "*" disables the check
# (never do that in production). Non-browser clients send no Origin and are
# allowed through (that is how the benchmark script connects).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# [USED] true when running behind a reverse proxy / load balancer, so the
# real client IP is taken from X-Forwarded-For for per-IP limits.
# Leave false when exposed directly: the header is trivially spoofable.
TRUST_PROXY=false

# [USED] Max simultaneous WebSocket connections per client IP
MAX_CONN_PER_IP=100

# ── Rooms & sync tuning ──────────────────────────────────────
# [USED] Hard cap of members per room (requirement: >= 10)
MAX_MEMBERS_PER_ROOM=50

# [USED] Hard cap of live rooms per process
MAX_ROOMS=500

# [USED] How long a dropped member keeps their seat (ms) before they are
# removed and host duties move on. Covers Wi-Fi blips and page refreshes.
RECONNECT_GRACE_MS=15000

# [USED] Empty rooms are garbage-collected after this many ms
ROOM_EMPTY_TTL_MS=300000

# [USED] Scheduled-start lead (ms). Play/seek commands carry a server start
# time this far in the future so every client starts the same instant.
# Must exceed worst-case one-way delay; 150–300 is right for LAN/same region.
PLAY_LEAD_MS=200

# [USED] Optional: directory of the built client to serve from the same
# process (Docker image sets this). Leave blank in dev (Vite serves it).
CLIENT_DIST=

# ── Client (Vite) ────────────────────────────────────────────
# [USED] Dev proxy target for /ws and /api. Only the Vite dev server reads it.
VITE_DEV_SERVER_TARGET=http://localhost:8080

# ── Movie metadata (optional enrichment) ─────────────────────
# [RESERVED] TMDB v3 key for poster/rating enrichment. The v1 catalog is
# self-contained (open-licensed sample films), so this is NOT required.
# Get one at https://www.themoviedb.org/settings/api — keep it server-side.
TMDB_API_KEY=dummy-tmdb-key-0000000000000000

# ── Horizontal scaling (roadmap) ─────────────────────────────
# [RESERVED] Redis Pub/Sub backplane so rooms can span several nodes.
# Format: redis://[:password@]host:port[/db]   (rediss:// for TLS)
REDIS_URL=redis://:dummy-password@localhost:6379/0

# [RESERVED] Postgres for persistent history (watch logs, saved playlists).
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://couch:dummy-password@localhost:5432/couchbeam?sslmode=prefer
