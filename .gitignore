# ─────────────────────────────────────────────────────────────
# Couchbeam .gitignore
# Rule of thumb: if it can hold a secret or can be regenerated, it is ignored.
# ─────────────────────────────────────────────────────────────

# ── Secrets & credentials (STRICT) ───────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.env
.envrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
credentials
credentials.*
**/credentials/
secrets/
**/secrets/
secret.*
*.secret
*.secrets
service-account*.json
serviceAccount*.json
gcloud*.json
client_secret*.json
.aws/
.azure/
.npmrc
.yarnrc.yml
.netrc
.htpasswd
*.tfvars
*.tfstate
*.tfstate.*
.terraform/
kubeconfig
*.kubeconfig

# ── Node / TypeScript / Next.js / Vite ───────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.pnp.*
dist/
build/
out/
.next/
.nuxt/
.vite/
.turbo/
.parcel-cache/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts
coverage/
.nyc_output/
*.lcov
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vercel
.netlify

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.ipynb_checkpoints/
pip-log.txt

# ── Go ───────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
vendor/
/bin/

# ── Logs & runtime data ──────────────────────────────────────
logs/
*.log
*.pid
*.pid.lock
*.seed
pids/

# ── Benchmark output (generated; the committed report lives in docs/) ──
benchmark-results.json
bench-out/

# ── Databases / local data ───────────────────────────────────
*.sqlite
*.sqlite3
*.db
dump.rdb
*.rdb
postgres-data/
redis-data/
.data/

# ── Docker overrides ─────────────────────────────────────────
docker-compose.override.yml

# ── IDE / editor artifacts ───────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~
.history/

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.rej
.claude/
